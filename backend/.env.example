# ─────────────────────────────────────────────────────────────────────────────
# ReelMate AI backend configuration
# Copy to .env and fill in what you actually have. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
APP_TIMEZONE=UTC

# Public URL of this API (used in docs / callbacks) and the frontend origin.
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (required for production). The docker-compose service below uses
# the same credentials. For local SQLite only, use:
# DATABASE_URL=sqlite+aiosqlite:///./reelmate.db
DATABASE_URL=postgresql+asyncpg://reelmate:reelmate@127.0.0.1:5432/reelmate
DATABASE_ECHO=false
AUTO_CREATE_TABLES=false
SEED_DEMO_DATA=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Optional shared secret between the Next.js proxy and this API.
# When set, every dashboard API request must send Authorization: Bearer <token>
# or X-API-Key: <token>. Keep it server-side only.
API_ACCESS_TOKEN=

# ── Instagram / Meta ─────────────────────────────────────────────────────────
# Official Instagram API with Instagram Login. A personal account is NOT
# supported by the official messaging API; only a professional (Business or
# Creator) account can be connected.
#
# HOW TO GET IG_APP_ID AND IG_APP_SECRET:
#   1. Go to https://developers.facebook.com/ and create a Meta app.
#   2. Add the "Instagram Basic Display" or "Instagram Messaging" product.
#   3. In App Settings > Basic, copy your App ID and App Secret here.
#   4. Add your OAuth redirect URI in the Facebook Login settings:
#      http://localhost:8000/api/v1/integration/oauth/callback
#   5. For messaging, your app must be reviewed and approved by Meta, and the
#      Instagram account must be a Business or Creator account.
#
# Without IG_APP_ID and IG_APP_SECRET the Connect Instagram button is disabled
# and the connection page clearly states OAuth is not configured.
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=http://localhost:8000/api/v1/integration/oauth/callback
IG_WEBHOOK_VERIFY_TOKEN=
# Optional fallback token for a single manually provisioned account. OAuth is
# preferred. Tokens are encrypted before they are stored.
IG_ACCESS_TOKEN=
IG_ACCOUNT_ID=
IG_GRAPH_VERSION=v23.0
IG_GRAPH_BASE_URL=https://graph.instagram.com
IG_MESSAGING_SCOPE=instagram_business_manage_messages
IG_OAUTH_SCOPES=instagram_business_basic,instagram_business_manage_messages

# ── AI provider ──────────────────────────────────────────────────────────────
# demo = no model calls (template replies + pre-written sample analyses only)
# openai = any OpenAI-compatible chat-completions endpoint with vision support
# gemini = Google Gemini generateContent API
AI_PROVIDER=demo
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_VIDEO_MODEL=
AI_TIMEOUT_SEC=90
AI_MAX_FRAMES=6
AI_MAX_OUTPUT_TOKENS=700
# Extra hostnames allowed for legitimate Instagram media downloads.
MEDIA_ALLOWED_HOSTS=cdninstagram.com,fbcdn.net,instagram.com

# ── Media / uploads ──────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=52428800
MAX_MEDIA_DOWNLOAD_BYTES=104857600
MEDIA_DOWNLOAD_TIMEOUT_SEC=30

# ── Background worker ────────────────────────────────────────────────────────
ENABLE_WORKER=true
WORKER_POLL_INTERVAL_SEC=1.0
JOB_MAX_ATTEMPTS=5

# ── Rate limits (per client IP / per window) ─────────────────────────────────
API_RATE_LIMIT_PER_MINUTE=120
SENSITIVE_RATE_LIMIT_PER_MINUTE=20
